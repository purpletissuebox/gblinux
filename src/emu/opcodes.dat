opcode_name_table:
align 8
;00-0F
	dw strings.add, strings.add, strings.add, strings.add, strings.add, strings.add, strings.push, strings.pop, strings.or, strings.or, strings.or, strings.or, strings.or, strings.or, strings.push, strings.pop
;10-1F
	dw strings.adc, strings.adc, strings.adc, strings.adc, strings.adc, strings.adc, strings.push, strings.pop, strings.sbb, strings.sbb, strings.sbb, strings.sbb, strings.sbb, strings.sbb, strings.push, strings.pop
;20-2F
	dw strings.and, strings.and, strings.and, strings.and, strings.and, strings.and, strings.nul, strings.daa, strings.sub, strings.sub, strings.sub, strings.sub, strings.sub, strings.sub, strings.nul, strings.das
;30-3F
	dw strings.xor, strings.xor, strings.xor, strings.xor, strings.xor, strings.xor, strings.nul, strings.aaa, strings.cmp, strings.cmp, strings.cmp, strings.cmp, strings.cmp, strings.cmp, strings.nul, strings.aas
;40-4F
	dw strings.inc, strings.inc, strings.inc, strings.inc, strings.inc, strings.inc, strings.inc, strings.inc, strings.dec, strings.dec, strings.dec, strings.dec, strings.dec, strings.dec, strings.dec, strings.dec
;50-5F
	dw strings.push, strings.push, strings.push, strings.push, strings.push, strings.push, strings.push, strings.push, strings.pop, strings.pop, strings.pop, strings.pop, strings.pop, strings.pop, strings.pop, strings.pop
;60-6F
	dw strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul, strings.nul
;70-7F
	dw strings.jo, strings.jno, strings.jb, strings.jnb, strings.je, strings.jne, strings.jbe, strings.ja, strings.js, strings.jns, strings.jpe, strings.jpo, strings.jl, strings.jge, strings.jle, strings.jg
;80-8F
	dw strings.nul, strings.nul, strings.nul, strings.nul, strings.test, strings.test, strings.xchg, strings.xchg, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.lea, strings.mov, strings.pop
;90-9F
	dw strings.nop, strings.xchg, strings.xchg, strings.xchg, strings.xchg, strings.xchg, strings.xchg, strings.xchg, strings.cbw, strings.cwd, strings.call, strings.wait, strings.push, strings.pop, strings.sahf, strings.lahf
;A0-AF
	dw strings.mov, strings.mov, strings.mov, strings.mov, strings.movsb, strings.movsw, strings.cmpsb, strings.cmpsw, strings.test, strings.test, strings.stosb, strings.stosw, strings.lodsb, strings.lodsw, strings.scasb, strings.scasw,
;B0-BF
	dw strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov, strings.mov
;C0-CF
	dw strings.nul, strings.nul, strings.ret, strings.ret, strings.les, strings.lds, strings.mov, strings.mov, strings.nul, strings.nul, strings.ret, strings.ret, strings.int, strings.int, strings.into, strings.iret
;D0-DF
	dw strings.nul, strings.nul, strings.nul, strings.nul, strings.aam, strings.aad, strings.nul, strings.xlat, strings.esc, strings.esc, strings.esc, strings.esc, strings.esc, strings.esc, strings.esc, strings.esc
;E0-EF
	dw strings.loopnz, strings.loopz, strings.loop, strings.jcxz, strings.in, strings.in, strings.out, strings.out, strings.call, strings.jp, strings.jp, strings.jp, strings.in, strings.in, strings.out, strings.out
;F0-FF
	dw strings.lock, strings.nul, strings.rept_nz, strings.rept_z, strings.halt, strings.cmc, strings.nul, strings.nul, strings.clc, strings.stc, strings.cli, strings.sti, strings.cld, strings.std, strings.nul, strings.nul

grp1_name_table:
